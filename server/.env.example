# Backend
PORT=5000
MONGO_URI=your_mongodb_connection_string
CLIENT_ORIGIN=http://localhost:5173

# Authentication - required from M3 onward
JWT_ACCESS_SECRET=change-me-in-production

# AI - required from M5 onward
GEMINI_API_KEY=your_gemini_api_key

# AI failover chain (M5.7) - optional; default is the single Gemini provider
# Ordered, comma-separated provider names. Unknown names are skipped with a
# startup warning. Only providers WITH their API key set participate at call
# time (keys are read live from the environment, never stored).
AI_PROVIDER_CHAIN=gemini
# Comma-separated model lists, in order. Defaults: gemini-3.6-flash (Gemini),
# openai/gpt-oss-20b (Groq).
AI_GEMINI_MODELS=gemini-3.6-flash
AI_GROQ_MODELS=openai/gpt-oss-20b
# Operations a Groq model may serve, out of RESUME_ANALYSIS, QUESTION_GENERATION,
# ANSWER_EVALUATION. Capability-gated (docs/16-ai-failover.md §3). Default:
# none - set explicitly to enable a Groq fallback.
#AI_GROQ_CAPABILITIES=RESUME_ANALYSIS,QUESTION_GENERATION,ANSWER_EVALUATION
# Lower the risk of a failed fallback by disabling failover entirely
# (collapses the operation to the first candidate only).
AI_FAILOVER_ENABLED=true
# Hard cap on total AI attempts per operation, across all candidates
# (default 4, allowed 1-10). Includes 429 backoff retries and corrections.
AI_MAX_TOTAL_ATTEMPTS=4
# Health cooldowns after an eligible failure (ms): quota exhaustion (long),
# rate limiting (short). Only active when a fallback candidate exists.
AI_QUOTA_COOLDOWN_MS=3600000
AI_RATE_LIMIT_COOLDOWN_MS=30000

# Storage - required from M6 onward
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_key
